# HeatLedger Environment Configuration
# Copy this file to .env for local development

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS)
# Default points to local docker container or local postgres
DATABASE_URL=postgresql://heatledger_user:heatledger_pass@localhost:5432/heatledger_db
DATABASE_SYNC_URL=postgresql://heatledger_user:heatledger_pass@localhost:5432/heatledger_db
TEST_DATABASE_URL=sqlite:///./test_heatledger.db

# Storage Configuration
# local | s3 | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads/private
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# AI / OCR Provider Configuration
# mock | gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash

# Environmental Providers Configuration
# IMD (India Meteorological Department)
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/public/api/

# Copernicus Climate Data Store (ERA5-Land)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# Default Demo Settings (Hyderabad)
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata
HYDERABAD_LATITUDE=17.3850
HYDERABAD_LONGITUDE=78.4867
